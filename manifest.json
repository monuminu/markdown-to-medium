{
  "manifest_version": 3,
  "name": "Markdown to Medium",
  "version": "1.1.1",
  "description": "A Chrome extension that converts markdown files to Medium.com articles",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://medium.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/*"
      ],
      "js": [
        "vendor/markdown-it.min.js",
        "ascii-table.js",
        "medium-markdown.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Markdown to Medium"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
